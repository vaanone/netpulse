// NETPULSE — ISP Network Monitoring Tool
// Cisco SFP & Ring Traffic Monitoring Dashboard

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = sqlite
  url      = env("DATABASE_URL")
}

/// An ISP customer company. Each company can have multiple branch rings.
model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rings       Ring[]
}

/// A branch ring — a physical ring of Cisco switches at one location.
model Ring {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String?
  location  String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  switches  Switch[]
  @@index([companyId])
}

model Switch {
  id              String   @id @default(cuid())
  name            String   @unique
  ipAddress       String
  location        String?
  snmpVersion     Int      @default(2)
  community       String?  @default("public")
  snmpPort        Int      @default(161)
  v3SecurityLevel String?
  v3Username      String?
  v3AuthProtocol  String?
  v3AuthPassword  String?
  v3PrivProtocol  String?
  v3PrivPassword  String?
  ringId          String?
  ring            Ring?    @relation(fields: [ringId], references: [id], onDelete: SetNull)
  nextSwitchId    String?  @unique
  nextSwitch      Switch?  @relation("RingNext", fields: [nextSwitchId], references: [id])
  prevSwitches    Switch[] @relation("RingNext")
  status          String   @default("unknown")
  lastSeen        DateTime?
  pollingMode     String   @default("auto")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  ports           SfpPort[]
  metrics         Metric[]
  alerts          Alert[]
  neighbors       CdpNeighbor[]
  @@index([ringId])
}

model CdpNeighbor {
  id              String   @id @default(cuid())
  switchId        String
  switch          Switch   @relation(fields: [switchId], references: [id], onDelete: Cascade)
  localIfIndex    Int
  localIfName     String?
  deviceId        String
  devicePort      String
  address         String?
  platform        String?
  protocol        String   @default("cdp")
  matchedSwitchId String?
  lastSeen        DateTime @default(now())
  @@index([switchId])
}

model SfpPort {
  id              String   @id @default(cuid())
  switchId        String
  switch          Switch   @relation(fields: [switchId], references: [id], onDelete: Cascade)
  ifIndex         Int
  ifName          String
  ifDescr         String?
  ifAlias         String?
  ifSpeed         BigInt?
  ifOperStatus    Int?
  ifAdminStatus   Int?
  txPower         Float?
  rxPower         Float?
  temperature     Float?
  voltage         Float?
  biasCurrent     Float?
  txWarnLow       Float?
  txWarnHigh      Float?
  txAlarmLow      Float?
  txAlarmHigh     Float?
  rxWarnLow       Float?
  rxWarnHigh      Float?
  rxAlarmLow      Float?
  rxAlarmHigh     Float?
  inOctets        BigInt?
  outOctets       BigInt?
  inHCOctets      BigInt?
  outHCOctets     BigInt?
  inErrors        BigInt?
  outErrors       BigInt?
  inDiscards      BigInt?
  outDiscards     BigInt?
  inBps           Float?
  outBps          Float?
  inUcastPkts     BigInt?
  outUcastPkts    BigInt?
  transceiverType String?
  vendorName      String?
  partNumber      String?
  serialNumber    String?
  wavelength      String?
  isRingPort      Boolean  @default(false)
  remoteSwitchId  String?
  remoteIfName    String?
  lastPolledAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([switchId])
  @@index([ifIndex])
}

model Metric {
  id              String   @id @default(cuid())
  switchId        String
  switch          Switch   @relation(fields: [switchId], references: [id], onDelete: Cascade)
  timestamp       DateTime @default(now())
  cpuUsage        Float?
  memoryUsage     Float?
  memoryTotal     Int?
  memoryUsed      Int?
  uptimeSeconds   Int?
  totalInBps      Float?
  totalOutBps     Float?
  minRxPower      Float?
  avgRxPower      Float?
  portsUp        Int?
  portsDown      Int?
  portsAlarm     Int?
  portsWarning   Int?
  @@index([switchId, timestamp])
  @@index([timestamp])
}

model Alert {
  id              String   @id @default(cuid())
  switchId        String?
  switch          Switch?  @relation(fields: [switchId], references: [id], onDelete: Cascade)
  portId          String?
  severity        String
  category        String
  message         String
  value           String?
  acknowledged    Boolean  @default(false)
  resolved        Boolean  @default(false)
  timestamp       DateTime @default(now())
  resolvedAt      DateTime?
  @@index([switchId])
  @@index([timestamp])
  @@index([severity])
}
