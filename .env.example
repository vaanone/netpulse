# NETPULSE environment variables — copy this file to `.env` and fill in.
# (.env itself is gitignored and must NOT be committed.)

# SQLite database location.
# NOTE: Prisma resolves relative paths against prisma/schema.prisma, so
# "../db/custom.db" means <project root>/db/custom.db — the database that is
# committed to git with the default admin already seeded. If DATABASE_URL is
# omitted (no .env), the app falls back to that same location automatically.
DATABASE_URL=file:../db/custom.db

# Secret used to sign session tokens (HMAC-SHA256). REQUIRED in production —
# generate a long random string, e.g. `openssl rand -hex 32`. In dev, if this
# is absent, an insecure fallback is used (a warning is logged).
SESSION_SECRET=change-me-to-a-long-random-string
